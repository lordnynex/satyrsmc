{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "allowImportingTsExtensions": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/components/*": ["./src/components/*"],
      "@/data/*": ["./src/data/*"],
      "@/state/*": ["./src/state/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/queries/*": ["./src/queries/*"],
      "@/lib/*": ["./src/lib/*"],
      "@/export/*": ["./src/export/*"],
      "@/trpc": ["./src/trpc.ts"]
    },
    "types": ["vite/client"]
  },
  "include": ["src/**/*", "vite.config.ts"]
}
