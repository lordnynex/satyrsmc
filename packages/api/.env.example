# Postgres connection (required unless USE_PGLITE=1)
DATABASE_URL=postgres://satyrs:satyrs@localhost:5432/satyrsmc

# JWT signing secret (required)
JWT_SECRET=established1954-satyrs-mc-dev-secret-key

# Set to 1 to use in-memory PGlite instead of Postgres (local dev only — data lost on restart)
# USE_PGLITE=1

# Optional: path to legacy SQLite file for PGlite auto-seed (default: data/badger.db)
# SQLITE_SEED_PATH=data/badger.db
