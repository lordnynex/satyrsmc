{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {},
    "allowImportingTsExtensions": true,
    "types": ["bun"]
  },
  "include": ["src/**/*", "scripts/**/*"]
}
