{
  "name": "@satyrsmc/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./trpc": "./src/trpc/root.ts",
    "./trpc/website": "./src/trpc/routers/website.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "NODE_ENV=production tsx src/index.ts",
    "build:function": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx,js,jsx}\"",
    "lint:fix": "eslint --fix \"src/**/*.{ts,tsx,js,jsx}\"",
    "db:start": "docker run -d --name satyrsmc-postgres -p 5432:5432 -e POSTGRES_USER=satyrs -e POSTGRES_PASSWORD=satyrs -e POSTGRES_DB=satyrsmc -v satyrsmc-pgdata:/var/lib/postgresql/data postgres:17-alpine && echo 'Postgres running on localhost:5432 — set DATABASE_URL=postgresql://satyrs:satyrs@localhost:5432/satyrsmc'",
    "db:stop": "docker stop satyrsmc-postgres && docker rm satyrsmc-postgres",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed-users.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@satyrsmc/shared": "workspace:*",
    "@trpc/server": "^11.0.0-rc.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jose": "^6.2.1",
    "jspdf": "^4.1.0",
    "pg": "^8.13.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pst-extractor": "^1.12.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "serverless-http": "^3.2.0",
    "sharp": "^0.34.5",
    "typeorm": "^0.3.28",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^4.1.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typeorm-pglite": "^0.3.1",
    "vitest": "^4.1.2"
  }
}
